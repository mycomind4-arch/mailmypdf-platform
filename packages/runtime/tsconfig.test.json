{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "outDir": "./dist-test",
    "rootDir": ".",
    "paths": {
      "@mailmypdf/core": ["../core/src/index.ts"],
      "@mailmypdf/workflows": ["../workflows/src/index.ts"],
      "@mailmypdf/proof": ["../proof/src/index.ts"],
      "@mailmypdf/fulfillment": ["../fulfillment/src/index.ts"]
    }
  },
  "include": ["src", "tests"]
}
